# Copy to .env and fill in. Only OPENROUTER_API_KEY costs money.
OPENROUTER_API_KEY=

# Any tool-calling model on OpenRouter at <= $1 per million input tokens.
SUPERVISOR_MODEL=openai/gpt-5-nano
AGENT_MODEL=anthropic/claude-haiku-4.5

DAILY_BUDGET_USD=1.00
MAX_COST_PER_REQUEST_USD=0.10

# Where the UI's Live/Mock switch starts. Mock is forced when no key is set.
MOCK_LLM=false

# Wikimedia asks for a descriptive User-Agent with a way to contact you.
WIKI_USER_AGENT=FanDesk-Demo/1.0 (contact: you@example.com)
